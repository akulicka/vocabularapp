# CLI (native MySQL on the host). Copy to .env — gitignored.
# Compose sets DB_HOST=db, DB_PORT=3306, HOST_DOMAIN=http://localhost on the backend.
# WSL + Windows MySQL: npm run wsl:dev / wsl:development / wsl:migrate
# (do not set DB_HOST here; those scripts set it).
# COOKIE_DOMAIN: leave unset locally (host-only cookies). Railway prod: .smartposting.ca

DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=
HOST_DOMAIN=http://localhost:5173
TOKEN_SECRET=
